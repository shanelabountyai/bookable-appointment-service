      "post": {
        "summary": "Add a client; a phone already on the book is AMBIGUOUS_CLIENT unless `allowDuplicate`. Requires `Idempotency-Key`.",
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "write",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 32
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "allowDuplicate": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "phone"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success (JSON)."
          },
          "default": {
            "description": "An error, as RFC 9457 problem+json with `code` and `next`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
