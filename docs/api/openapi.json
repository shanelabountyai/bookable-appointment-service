                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  },
                  "providerId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dayParts": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "sunday",
                        "monday",
                        "tuesday",
                        "wednesday",
                        "thursday",
                        "friday",
                        "saturday",
                        "morning",
                        "afternoon",
                        "evening"
                      ]
                    }
                  }
                },
                "required": [
                  "clientId",
                  "serviceIds",
                  "dayRange"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success (JSON)."
          },
          "default": {
            "description": "An error, as RFC 9457 problem+json with `code` and `next`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
