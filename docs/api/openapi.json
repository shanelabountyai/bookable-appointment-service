    "/api/v1/clients": {
      "get": {
        "summary": "Up to five matches: name, phone last 4, reliability.",
        "security": [
          {
            "bearer": []
          }
        ],
        "x-scope": "read",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
