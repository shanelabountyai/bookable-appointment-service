# Copy to .env.local for real dev values. Names only here — see
# CLAUDE.md "Source control" (never commit real values).

# Local Postgres. .env.test overrides only DATABASE_URL/DIRECT_URL, first-wins
# via `dotenv -e .env.test -e .env.local`.
DATABASE_URL=
DIRECT_URL=

PORT=3300

# Signs the staff session cookie (D-9). REQUIRED — the app refuses to handle
# sessions without it rather than falling back to a default, because a default
# means every deployment that forgot to set one shares a forgeable key.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Notification safety controls (D-14). Both optional.
# NOTIFICATIONS_ENABLED=false stops all sending; rows are still recorded as
# suppressed so "what would have gone out" stays answerable.
# NOTIFICATIONS_SANDBOX_TO redirects every send to one address while the outbox
# still records the intended recipient.
NOTIFICATIONS_ENABLED=
NOTIFICATIONS_SANDBOX_TO=

# Bearer secret the reminder job's route (/api/jobs/reminders) checks against
# an Authorization header (A-022). REQUIRED — the route refuses to run rather
# than falling back to open, same reasoning as SESSION_SECRET.
# Generate with: openssl rand -base64 32
CRON_SECRET=
