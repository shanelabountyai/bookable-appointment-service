# Copy to .env.local for real dev values. Names only here — see
# CLAUDE.md "Source control" (never commit real values).

# Local Postgres. .env.test overrides only DATABASE_URL/DIRECT_URL, first-wins
# via `dotenv -e .env.test -e .env.local`.
DATABASE_URL=
DIRECT_URL=

PORT=3300

# Signs the staff session cookie (D-9). REQUIRED — the app refuses to handle
# sessions without it rather than falling back to a default, because a default
# means every deployment that forgot to set one shares a forgeable key.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Notification safety controls (D-14). Both optional.
# NOTIFICATIONS_ENABLED=false stops all sending; rows are still recorded as
# suppressed so "what would have gone out" stays answerable.
# NOTIFICATIONS_SANDBOX_TO redirects every send to one address while the outbox
# still records the intended recipient.
NOTIFICATIONS_ENABLED=
NOTIFICATIONS_SANDBOX_TO=

# Bearer secret the reminder job's route (/api/jobs/reminders) checks against
# an Authorization header (A-022). REQUIRED — the route refuses to run rather
# than falling back to open, same reasoning as SESSION_SECRET.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# K11: every other variable the code reads. Names only. The web app's boot
# schema (apps/web/lib/env.ts, run by apps/web/instrumentation.ts) requires
# DATABASE_URL and SESSION_SECRET; everything else is optional and keeps the
# meaning its reader gives it. apps/web/lib/env.test.ts keeps this list honest.

# D-65 demo gate: one shared password over the whole hosted site. Unset locally
# and in CI = no gate.
DEMO_ACCESS_PASSWORD=

# Outbound webhooks: '1' lets an endpoint be http://localhost (test receivers).
WEBHOOK_ALLOW_PRIVATE=

# K12 escape hatch: tests refuse a non-local DATABASE_URL unless this is 1.
ALLOW_CLOUD_DB=

# Set by the platform, never by hand: NODE_ENV, NEXT_RUNTIME (Next), VERCEL and
# PRISMA_QUERY_ENGINE_LIBRARY (packages/db/index.ts sets it at runtime on
# Vercel), CI (GitHub Actions).
NODE_ENV=
NEXT_RUNTIME=
VERCEL=
PRISMA_QUERY_ENGINE_LIBRARY=
CI=

# Tools outside the web app.
# apps/mcp/src/stdio.ts — an MCP token issued on /staff/people.
BOOKABLE_MCP_TOKEN=
# scripts/webhook-receiver.ts — comma-separated signing secrets, and its port.
WEBHOOK_SECRET=
WEBHOOK_RECEIVER_PORT=
# apps/mcp eval harness.
EVAL_MODEL=
EVAL_ONLY=
EVAL_DRY_RUN=
EVAL_COST_CAP_USD=
# Test-run switches: e2e dev server, nightly fuzz, fast-check seed, OpenAPI
# snapshot rewrite, CI drift check's shadow database.
E2E_DEV=
FUZZ=
FC_RANDOM_SEED=
UPDATE_OPENAPI=
SHADOW_DATABASE_URL=
