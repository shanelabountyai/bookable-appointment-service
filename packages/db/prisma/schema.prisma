// Bookable — core data model (A-003).
//
// NORMATIVE: 00-master-prd.md §6/§8, 07-decisions.md (D-2, D-7, D-8, D-12..D-21),
// docs/reviews/03-slot-engine-spec.md §4.
//
// RULES THIS FILE OBEYS, EACH OF WHICH COST A SIBLING BUILD A DEFECT:
//
//  * `@db.Date` is BANNED (D-3). A CalendarDay is `String @db.Char(10)` and a
//    WallTime is `String @db.Char(5)`. Postgres `date` -> JS `Date` is the exact
//    path that produced the rental build's silent day-west shift with ten green
//    tests. You give up SQL date arithmetic to make the axis error unrepresentable.
//  * Money is integer cents. Never a float, never a Decimal-that-becomes-a-float.
//  * `businessId` is on every core table (D-13) — free now, touches every query
//    if retrofitted.
//  * Instants are `@db.Timestamptz(3)` and are CHECK-constrained to whole minutes
//    in the migration: half-open [start, end) back-to-back booking depends on
//    `A.blockedEnd = B.blockedStart` EXACTLY, and one stray millisecond turns
//    "back-to-back" into a false conflict or a 1ms hole with every test green.
//
// WHAT PRISMA CANNOT EXPRESS, AND SO LIVES IN THE HAND-WRITTEN MIGRATION:
//   1. `CREATE EXTENSION btree_gist` — required, or a text providerId has no
//      gist operator class.
//   2. The `appointment_no_overlap` EXCLUDE constraint (D-2/D-15).
//   3. The `appointment_blocked_range` BEFORE INSERT OR UPDATE trigger that
//      computes blockedStart/blockedEnd (they CANNOT be generated columns:
//      `timestamptz + interval` is STABLE, not IMMUTABLE — verified).
//   4. The `AppointmentEvent` append-only trigger.
//   5. The whole-minute CHECK constraints.
// NEVER `prisma db push` on this project, and never edit an applied migration.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────

/// D-7. Eight states, normative transition table in 00-master-prd.md §7.
/// A Postgres enum rather than free text: adding a state is deliberately an
/// ALTER TYPE, because "a status enum is never one edit" — every reader
/// (constraint predicate, busy set, reminder eligibility, day-view filters)
/// must be revisited. See packages/core/scheduling/status.ts, which is the
/// single source of truth these values are asserted against by test.
enum AppointmentStatus {
  booked
  confirmed
  checked_in
  in_progress
  completed
  no_show
  cancelled
  cancelled_late
}

/// D-9. Stamped on every mutation; without it there is no cutoff that applies
/// to customers but not staff, and no audit log worth the name.
enum Actor {
  staff
  customer_token
  system
}

enum NotificationChannel {
  email
  sms
}

enum OutboxStatus {
  pending
  /// A-048. CLAIMED by a dispatcher and not yet resolved. The fifth state is
  /// what makes "exactly one send" a database fact rather than a hope: the
  /// claim is a single `UPDATE ... WHERE status = 'pending' ... RETURNING`, so
  /// a second dispatcher racing for the same row matches nothing.
  ///
  /// A row can be STUCK here if the process holding it dies mid-send (a
  /// function timeout is the realistic case), so `dispatchPendingNotifications`
  /// reclaims `sending` rows that have gone stale. That reclaim is the one
  /// place a double-send is still possible — a merely slow dispatcher, not a
  /// dead one — which is why the window is generous and why `externalId`
  /// exists to reconcile against the provider.
  sending
  sent
  failed
  suppressed
}

/// P1-5: without a lifecycle the "who wants this slot?" panel fills with stale
/// entries the front desk learns to ignore.
enum WaitlistStatus {
  active
  fulfilled
  expired
  cancelled
}

/// D-12. `retired` is unused today: editing a service REPLACES its segment
/// rows (A-029), because nothing references one — D-18 has each
/// AppointmentServiceLine snapshotting its own duration at booking time.
enum SegmentStatus {
  active
  retired
}

// ─────────────────────────── tenancy & config ───────────────────────────

model Business {
  id       String @id @default(cuid())
  name     String
  /// IANA zone id, "America/Chicago". Never a fixed offset or abbreviation —
  /// neither survives a DST transition.
  timezone String

  // Policies (D-11, D-19, D-21).
  slotIntervalMinutes       Int @default(15)
  minimumLeadMinutes        Int @default(120)
  /// Startup validation enforces minimumLeadMinutes >= cancellationCutoffMinutes
  /// (D-11): otherwise a customer books 5 minutes out and is instantly unable to
  /// cancel it — trapped by design, phone call required.
  cancellationCutoffMinutes Int @default(120)
  noShowBlockThreshold      Int @default(3)
  /// D-21: 90 days, SELF-SERVE ONLY. Staff booking ignores the horizon.
  bookingHorizonDays        Int @default(90)

  // D-19: the SlotPolicy flags the engine reads. They live here because
  // SLOT-04 requires tests on both arms, and hardcoding them in the engine
  // makes that untestable without a migration.
  bufferMayOverlapBreak    Boolean @default(true)
  bufferMayExtendPastClose Boolean @default(true)
  /// 'offer-both' | 'offer-earlier-only' (spec FB-7).
  ambiguousLocalTime       String  @default("offer-both")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  staffUsers    StaffUser[]
  providers     Provider[]
  services      Service[]
  resourceTypes ResourceType[]
  resources     Resource[]
  weeklyWindows WeeklyWindow[]
  dateOverrides DateOverride[]
  timeOff       TimeOff[]
  adHocBlocks   AdHocBlock[]
  clients       Client[]
  appointments  Appointment[]
  events        AppointmentEvent[]
  outbox        NotificationOutbox[]
  waitlist      WaitlistEntry[]
  manageTokens  ManageToken[]
  runningLate   ProviderRunningLate[]
}

/// D-9. One shared owner credential in v1; multi-user staff auth and roles are
/// Phase 3. Stated as minimal so nobody builds role machinery in month one.
model StaffUser {
  id           String   @id @default(cuid())
  businessId   String
  /// NULLABLE since A-037: a PIN-only staff member is an IDENTITY, not an
  /// account. The stylist who needs her name on a check-in does not need a
  /// way to sign in from home, and giving her one to satisfy a NOT NULL would
  /// be a credential nobody asked for. No email = cannot authenticate, ever.
  email        String?
  passwordHash String?
  /// A-037: the name the event log says. `actorRef` has carried this row's id
  /// since A-005 and nothing could render it, so every mutation read "by the
  /// front desk" for all four people at the terminal.
  name         String
  /// The desk switch (D-33). Null means this person cannot be switched to —
  /// they still have a full credential, they just have no fast path. Hashed
  /// with the same scrypt as a password: a PIN is a secret at rest whatever
  /// its length.
  pinHash      String?
  /// Off-boarding is DEACTIVATION, never deletion. Deleting the row would
  /// take the name out of every event it ever stamped, and "who moved this
  /// appointment" losing its answer is the thing A-037 exists to prevent.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
}

// ─────────────────────────── catalog ───────────────────────────

model Provider {
  id          String  @id @default(cuid())
  businessId  String
  displayName String
  /// P1-3: a stylist quitting with three weeks booked is more common and harder
  /// than deactivating a service, and had no field before this.
  active      Boolean @default(true)
  /// Ties in the "any provider" assignment rule are broken by this (SVC-02),
  /// which makes the rule deterministic and therefore assertable.
  displayOrder Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceProviders ServiceProvider[]
  weeklyWindows    WeeklyWindow[]
  dateOverrides    DateOverride[]
  timeOff          TimeOff[]
  adHocBlocks      AdHocBlock[]
  appointments     Appointment[]
  runningLate      ProviderRunningLate[]

  @@index([businessId, active])
}

model Service {
  id                  String  @id @default(cuid())
  businessId          String
  name                String
  durationMinutes     Int
  bufferBeforeMinutes Int     @default(0)
  bufferAfterMinutes  Int     @default(0)
  priceCents          Int
  active              Boolean @default(true)
  displayOrder        Int     @default(0)
  /// D-19 + D-11 resolver: `service.cutoff ?? business.cutoff`. Nullable means
  /// "inherit", which is distinct from "zero".
  cancellationCutoffMinutes Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// RES-01. NULL means this service needs no resource — a phone consult, and
  /// every service in a business that has not defined resources at all. That
  /// nullability is what made A-031 additive.
  requiredResourceTypeId String?
  requiredResourceType   ResourceType? @relation(fields: [requiredResourceTypeId], references: [id], onDelete: SetNull)

  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceProviders ServiceProvider[]
  segments         ServiceSegment[]
  lines            AppointmentServiceLine[]
  waitlist         WaitlistEntry[]

  @@index([businessId, active])
}

/// Qualification + per-provider overrides (SVC-02). An unassigned provider
/// never appears in that service's booking flow.
model ServiceProvider {
  id                      String @id @default(cuid())
  businessId              String
  serviceId               String
  providerId              String
  durationOverrideMinutes Int?
  priceOverrideCents      Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceId, providerId])
  @@index([businessId])
  @@index([providerId])
}

/// SEG-01 (A-029). An ordered list of parts: a cut is unsegmented, a colour is
/// three rows (45 active / 35 gap / 30 active). No rows means ONE implicit
/// active segment of the whole `Service.durationMinutes`, which is why A-029
/// needed no backfill — every service built before it is already correct.
///
/// The parts MUST sum to `Service.durationMinutes`, which stays authoritative
/// because it is what `blockedStart`/`blockedEnd` — the range the exclusion
/// constraint actually enforces — are derived from. Enforced in
/// packages/core/settings/segments.ts and a test, not by a trigger: today a
/// drifted sum is a display defect. It becomes a correctness one at A-030,
/// where the ENGINE starts reading these rows, and that row is gated on OQ-7.
model ServiceSegment {
  id              String        @id @default(cuid())
  businessId      String
  serviceId       String
  ordinal         Int
  durationMinutes Int
  /// True for a processing gap (colour developing) — bookable provider time in
  /// Phase 3, which is where a colourist's Saturday revenue lives.
  isGap           Boolean       @default(false)
  status          SegmentStatus @default(active)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, ordinal])
  @@index([businessId])
}

/// D-12 + D-20 affordance ONLY: built, unreferenced by the engine in v1.
/// For a 4-chair salon with 4 stylists the pool never binds, so consuming it
/// would be enforcement theatre — and adding an axis to a LIVE exclusion
/// constraint later is the migration D-12 exists to avoid.
model ResourceType {
  id         String @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resources Resource[]
  services  Service[]

  @@unique([businessId, name])
}

model Resource {
  id             String @id @default(cuid())
  businessId     String
  resourceTypeId String
  name           String
  active         Boolean @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resourceType ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  holds        AppointmentResourceHold[]

  @@index([businessId])
}

// ─────────────────────────── availability (WALL-CLOCK RULES) ───────────────────────────
// Everything in this section is on the CALENDAR axis: wall-clock strings, no
// offsets, no instants. "I work Tuesdays 9-5" means 9-5 whatever the offset is
// that week. Resolution to instants happens in packages/core/time, once, at the
// boundary — and the engine unions windows AFTER resolution, never before
// (spec DST-7).

/// AVAIL-01 / AVAIL-04. `providerId = NULL` means this is a BUSINESS-level
/// window (business hours); effective availability = business ∩ provider.
model WeeklyWindow {
  id         String  @id @default(cuid())
  businessId String
  providerId String?
  /// 0 = Sunday .. 6 = Saturday.
  weekday    Int
  /// WallTime "09:00". CHAR(5), never a DateTime — this is a rule, not an occurrence.
  open       String  @db.Char(5)
  close      String  @db.Char(5)
  /// Required, never inferred: `close <= open` with endsNextDay=false is
  /// malformed and is refused at write time (AVAIL-01).
  endsNextDay Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)


  /// WHO changed this, and why (operator review R-8). `AppointmentEvent`
  /// covers appointments and stops at the appointment boundary, so "who
  /// blocked Dana's 2-4?" and "the book said she worked till 5, why did the
  /// system stop offering 4:30?" had no answer at all. Availability edits are
  /// destructive UPDATEs, so without this the previous state is simply gone.
  createdByActor Actor?  @default(staff)
  actorRef       String?
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  breaks   WindowBreak[]

  @@index([businessId, providerId, weekday])
}

/// Breaks belong to the WINDOW, not the day (spec OV-9). A provider with a
/// split shift has two windows, and lunch belongs to exactly one of them.
model WindowBreak {
  id             String @id @default(cuid())
  businessId     String
  weeklyWindowId String
  open           String @db.Char(5)
  close          String @db.Char(5)

  weeklyWindow WeeklyWindow @relation(fields: [weeklyWindowId], references: [id], onDelete: Cascade)

  @@index([weeklyWindowId])
  @@index([businessId])
}

/// AVAIL-02. A parent record so that "closed" is representable and DISTINCT
/// from "no override" — `isClosed=true` with zero child windows. An override
/// REPLACES the weekly pattern for that date entirely; it never merges.
model DateOverride {
  id         String  @id @default(cuid())
  businessId String
  providerId String?
  /// CalendarDay "2026-03-08". CHAR(10) — NEVER @db.Date (D-3).
  day        String  @db.Char(10)
  isClosed   Boolean @default(false)
  reason     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)


  /// WHO changed this, and why (operator review R-8). `AppointmentEvent`
  /// covers appointments and stops at the appointment boundary, so "who
  /// blocked Dana's 2-4?" and "the book said she worked till 5, why did the
  /// system stop offering 4:30?" had no answer at all. Availability edits are
  /// destructive UPDATEs, so without this the previous state is simply gone.
  createdByActor Actor?  @default(staff)
  actorRef       String?
  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider Provider?             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  windows  DateOverrideWindow[]

  /// AVAIL-02: two overrides on one date is a validation error, made structural.
  @@unique([businessId, providerId, day])
  @@index([businessId, day])
}

model DateOverrideWindow {
  id             String  @id @default(cuid())
  businessId     String
  dateOverrideId String
  open           String  @db.Char(5)
  close          String  @db.Char(5)
  endsNextDay    Boolean @default(false)

  dateOverride DateOverride @relation(fields: [dateOverrideId], references: [id], onDelete: Cascade)

  @@index([dateOverrideId])
  @@index([businessId])
}

// ─────────────────────────── absences (INSTANT INTERVALS) ───────────────────────────
// TimeOff and AdHocBlock are INSTANT intervals, and they are deliberately
// OUTSIDE the exclusion constraint's table (D-2). That is not an oversight:
// AVAIL-05 requires that blocking over an existing booking SURFACE the conflict
// for a human to resolve, not be refused by the database. A constraint here
// would make "Dana called in sick" impossible to record while she has bookings.

model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  providerId String
  startAt    DateTime @db.Timestamptz(3)
  endAt      DateTime @db.Timestamptz(3)
  reason     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)


  /// WHO changed this, and why (operator review R-8). `AppointmentEvent`
  /// covers appointments and stops at the appointment boundary, so "who
  /// blocked Dana's 2-4?" and "the book said she worked till 5, why did the
  /// system stop offering 4:30?" had no answer at all. Availability edits are
  /// destructive UPDATEs, so without this the previous state is simply gone.
  createdByActor Actor?  @default(staff)
  actorRef       String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([businessId, providerId, startAt, endAt])
}

model AdHocBlock {
  id         String   @id @default(cuid())
  businessId String
  providerId String
  startAt    DateTime @db.Timestamptz(3)
  endAt      DateTime @db.Timestamptz(3)
  reason     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)


  /// WHO changed this, and why (operator review R-8). `AppointmentEvent`
  /// covers appointments and stops at the appointment boundary, so "who
  /// blocked Dana's 2-4?" and "the book said she worked till 5, why did the
  /// system stop offering 4:30?" had no answer at all. Availability edits are
  /// destructive UPDATEs, so without this the previous state is simply gone.
  createdByActor Actor?  @default(staff)
  actorRef       String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([businessId, providerId, startAt, endAt])
}

// ─────────────────────────── people ───────────────────────────

/// D-17 (answers OQ-2). `phone` is INDEXED, NOT UNIQUE.
///
/// A household shares a number. A unique index silently makes a mother and her
/// teenage daughter ONE client: merged allergy notes (CLIENT-03 calls that a
/// safety surface) and one shared rolling no-show counter, so the daughter's
/// two no-shows block the mother from self-serve booking under CLIENT-04.
/// Unwinding that after records have merged is data repair, not a migration.
///
/// name/phone/email are ALL nullable, which serves two needs at once:
/// BOOK-04's "walk-in, no name" is a real row, and a deletion request is served
/// by anonymizing in place — AppointmentEvent is append-only with Restrict FKs,
/// so there is otherwise no deletion path through this schema at all.
model Client {
  id         String  @id @default(cuid())
  businessId String
  name       String?
  /// Normalized E.164 at write time.
  phone      String?
  email      String?
  /// Pinned notes render on every appointment surface (CLIENT-03).
  notes      String?
  /// P2-3: consent is collected at booking time and cannot be backfilled —
  /// without it you must assume none and re-ask everyone.
  smsConsentAt DateTime? @db.Timestamptz(3)

  /// A-015 / operator R-10. When this record LOST a merge, it stays as a
  /// tombstone pointing at the survivor instead of being deleted.
  ///
  /// The row has to survive: it is what the losing record's phone number still
  /// finds. A salon merges "Ada Chen 5125550101" into "Ada Chen-Marsh
  /// 5125550199" and six weeks later Ada rings from the old number — deleting
  /// the loser makes that number unknown to the salon, which is exactly the
  /// moment the front desk needs it to work. Deleting is also impossible in
  /// practice: `AppointmentEvent` is append-only with `onDelete: Restrict`.
  ///
  /// Chains are flattened rather than followed: merging B into C re-points
  /// every tombstone already aimed at B, so resolution is always ONE hop and
  /// no recursive query — or cycle — is possible.
  mergedIntoClientId String?
  mergedAt           DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  waitlist     WaitlistEntry[]

  /// Restrict, not Cascade: a survivor that could be deleted out from under
  /// its tombstones would leave the old phone number pointing at nothing.
  mergedInto   Client?  @relation("ClientMerge", fields: [mergedIntoClientId], references: [id], onDelete: Restrict)
  mergedFrom   Client[] @relation("ClientMerge")

  @@index([businessId, phone])
  @@index([businessId, name])
  @@index([mergedIntoClientId])
}

// ─────────────────────────── the appointment ───────────────────────────

model Appointment {
  id         String @id @default(cuid())
  businessId String
  providerId String
  /// NULLABLE — BOOK-04 requires booking with no client record ("walk-in, no
  /// name", identity attached later).
  clientId   String?

  status AppointmentStatus @default(booked)

  /// The occurrence, on the PHYSICAL axis. Whole minutes, CHECK-enforced.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  /// Buffer snapshots. Stored on the appointment (not read live from Service)
  /// for the same reason as the price snapshot in D-18, and additionally
  /// because the blocked-range trigger must be able to recompute the range on
  /// UPDATE without re-deriving which service's buffers applied at booking time.
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)

  /// D-29/A-030. Alternating minutes from the start of the BODY, beginning and
  /// ending with an ACTIVE part: {45} a cut, {50,40,30} a colour, and
  /// {60,35,25,30,30} the seeded balayage. Even positions are worked, odd ones
  /// are processing gaps. EMPTY means one continuous block, which is why
  /// A-030 needed no backfill.
  ///
  /// Snapshotted for the same reason as the buffers above (D-18): the trigger
  /// must recompute blocks on UPDATE without re-deriving which service's
  /// segments applied at booking time, and re-splitting a service must never
  /// re-cut an appointment already in the book. A CHECK asserts the parts are
  /// positive, odd in count, and sum to endAt - startAt.
  segmentPattern Int[] @default([])

  /// Body ± buffers. WRITTEN BY TRIGGER, never by application code — see the
  /// migration. They cannot be generated columns: `timestamptz + interval` is
  /// STABLE, not IMMUTABLE (verified against PG17), which disqualifies it from
  /// GENERATED ALWAYS AS ... STORED. The exclusion constraint ranges over these,
  /// so a buffer-only overlap is refused too.
  ///
  /// A-030 changed what these MEAN: they are now the appointment's outer
  /// ENVELOPE, used for display and for windowing the busy-set query. What the
  /// database enforces is `AppointmentBlock` (D-29) — one row per span the
  /// provider is actually working, because a single range cannot express the
  /// hole a colour's developing time leaves.
  blockedStart DateTime @db.Timestamptz(3)
  blockedEnd   DateTime @db.Timestamptz(3)

  /// D-8. A staff override writes a ZERO-WIDTH blocked range, which participates
  /// in no `&&` and so satisfies the constraint without weakening it — and the
  /// true intended range is preserved here.
  isOverride          Boolean @default(false)
  overrideReason      String?
  /// D-16. The engine's busy-set query MUST read
  /// COALESCE(overriddenFromRange, tstzrange(blockedStart, blockedEnd, '[)')).
  /// Without that, a zero-width override row blocks nothing, the public flow
  /// offers the overridden time, and a customer creates the accidental
  /// double-book Goal 2 promises is impossible. Type is tstzrange, added in the
  /// migration (Prisma has no range type).
  overriddenFromRange Unsupported("tstzrange")?

  /// BOOK-03(f). Makes the write path safely retryable.
  idempotencyKey String?

  /// P1-6. Denormalized business-zone labels, written alongside the instants by
  /// the same code path. RPT-02 and the day view group by business date, and
  /// deriving that from a timestamptz needs a zone conversion in every query.
  /// Also gives Phase 3's tzdata-drift job (spec X-5) something to reconcile
  /// against — without it, drift is undetectable for anything booked earlier.
  startDay      String @db.Char(10)
  startWallTime String @db.Char(5)

  /// The PER-VISIT note (CLIENT-03), distinct from Client.notes. "Bring the
  /// reference photo", "patch test done 12/4". Without it these go in the
  /// pinned client note, where they accumulate forever and bury the allergy
  /// line that is a genuine safety surface. (Operator review R-6.)
  notes String?

  /// AVAIL-05's "keep-flagged": the human acknowledgment that a conflict has
  /// been dealt with ("we called her, she's coming anyway").
  ///
  /// The CONFLICT itself stays derived (appointment ∩ absence) — a stored
  /// conflict flag goes stale and lies on the day it matters. Only the
  /// acknowledgment is stored, because it is not derivable from anything.
  /// Cleared whenever the overlapping absence changes. (Operator review R-7.)
  conflictAckAt     DateTime? @db.Timestamptz(3)
  conflictAckReason String?

  /// APPT-03/04: actual vs scheduled. A book that cannot represent "actually
  /// started" is a paper-book generator (D-7).
  confirmedAt DateTime? @db.Timestamptz(3)
  checkedInAt DateTime? @db.Timestamptz(3)
  startedAt   DateTime? @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// D-30. Which chair this appointment holds. Chosen by the booking path —
  /// first free resource of the service's required type — and never typed by a
  /// human. NULL means no chair is held: a service needing none, a business
  /// with no resources, or a staff override, which deliberately holds nothing
  /// for the same reason D-8's override writes a zero-width provider range.
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  lines         AppointmentServiceLine[]
  events        AppointmentEvent[]
  tokens        ManageToken[]
  notifications NotificationOutbox[]
  blocks        AppointmentBlock[]
  resourceHold  AppointmentResourceHold?

  @@unique([businessId, idempotencyKey])
  /// The busy-set query is an instant-overlap predicate over these columns —
  /// never `WHERE date(startAt) = day`, which misses the 23:30 booking running
  /// past midnight and then double-books 00:00.
  @@index([providerId, blockedStart, blockedEnd])
  @@index([businessId, startDay])
  @@index([businessId, status])
  @@index([clientId])
}

/// Plural-shaped from day one (D-12): v1 flows create exactly one line, and
/// VISIT work makes it many. Retrofitting plural lines onto a single-service
/// appointment costs every query and a migration.
model AppointmentServiceLine {
  id            String @id @default(cuid())
  businessId    String
  appointmentId String
  serviceId     String
  ordinal       Int    @default(0)

  /// D-18: SNAPSHOTTED at write time, never read live from Service /
  /// ServiceProvider. Otherwise the owner raises prices in January and last
  /// year's client history (CLIENT-02) and every historical report retroactively
  /// change — and the old price is unrecoverable.
  priceCents      Int
  durationMinutes Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, ordinal])
  @@index([businessId])
  @@index([serviceId])
}

/// APPT-07. APPEND-ONLY, enforced by trigger in the migration — UPDATE and
/// DELETE both raise. FKs into it are `onDelete: Restrict` on purpose: SetNull
/// cascades hit the trigger and fail at runtime, which the rental build learned
/// twice.
/// D-29 (A-030) — THE UNIT THE EXCLUSION CONSTRAINT RANGES OVER.
///
/// One row per span the provider is actually working. An unsegmented
/// appointment has exactly one; a colour has two, with its developing time
/// between them; a staff override has one zero-width row (D-8/D-16).
///
/// WRITTEN BY TRIGGER, never by application code — see the migration. The
/// property being protected is the one `blockedStart`/`blockedEnd` already had:
/// no ORM call, script or psql session can write an inconsistent range, and a
/// write path that forgot to emit a block would UNDER-block and double-book
/// without the constraint being able to tell.
///
/// `providerId` and `status` are denormalised because a partial exclusion
/// constraint cannot join. The trigger is their only writer, and a test still
/// asserts the constraint predicate equals ACTIVE_STATUSES.
model AppointmentBlock {
  id            String @id
  businessId    String
  appointmentId String
  providerId    String
  status        AppointmentStatus
  ordinal       Int
  blockedStart  DateTime @db.Timestamptz(3)
  blockedEnd    DateTime @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, ordinal])
  @@index([appointmentId])
  @@index([providerId, blockedStart, blockedEnd])
}

/// D-30 (A-031) — THE RESOURCE INVARIANT.
///
/// One row per appointment that holds a chair, spanning its WHOLE envelope,
/// gaps included. That is the one place resource occupancy differs from provider
/// occupancy (`AppointmentBlock`, D-29): a client developing colour is not using
/// her stylist and is certainly using the chair.
///
/// WRITTEN BY TRIGGER, never by application code — same reasoning as every other
/// range in this schema.
model AppointmentResourceHold {
  id            String @id
  businessId    String
  appointmentId String @unique
  resourceId    String
  status        AppointmentStatus
  blockedStart  DateTime @db.Timestamptz(3)
  blockedEnd    DateTime @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@index([resourceId, blockedStart, blockedEnd])
}

model AppointmentEvent {
  id            String @id @default(cuid())
  businessId    String
  appointmentId String

  /// e.g. "booked", "rescheduled", "checked_in", "override_booked",
  /// "notification_skipped_no_recipient". Rendered in plain language on the
  /// appointment detail panel (A-027).
  type      String
  actor     Actor
  /// Which staff user / token acted, when identifiable.
  actorRef  String?
  reason    String?
  /// Both sides of a reschedule live here (D-6) — the row survives, so history
  /// is in the log rather than in a dead row.
  payload   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
  @@index([businessId, createdAt])
}

// ─────────────────────────── customer link & notifications ───────────────────────────

/// D-5. Multi-use until `end + 24h`, scoped to ONE appointment, revocable by
/// reissue, RE-POINTED (not reissued) on reschedule. Single-use was rejected:
/// confirm-then-later-cancel and reschedule-twice are the ORDINARY customer
/// workflow, and a single-use token fails on step two of every appointment.
model ManageToken {
  id            String @id @default(cuid())
  businessId    String
  appointmentId String
  /// Store the hash, never the token.
  tokenHash     String @unique

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([businessId])
}

/// D-14. The outbox + ChannelAdapter seam is Milestone 1 infrastructure, built
/// BEFORE the first thing that sends — otherwise sending gets hand-rolled at
/// call sites and the outbox arrives to find three of them.
model NotificationOutbox {
  id         String @id @default(cuid())
  businessId String

  /// P1-7: a reminder key MUST include the target instant
  /// (`reminder-24h:{appointmentId}:{startAtEpochMs}`). Keyed on appointment id
  /// alone, an appointment rescheduled INTO an already-processed window is never
  /// reminded, and one rescheduled OUT keeps a reminder for a time that no
  /// longer exists.
  dedupeKey String @unique

  /// Which appointment this is about, when it is about one. NULLABLE because
  /// not every message has one (system/marketing messages later).
  ///
  /// APPT-07 promises the outbox is queryable per appointment — "was she
  /// actually told?" is the question that settles an argument at the front
  /// desk. The dedupeKey cannot serve: the reminder key deliberately embeds
  /// startAtEpochMs (P1-7), so a rescheduled appointment's messages no longer
  /// share a prefix and the query becomes a LIKE against a key format.
  /// (Operator review R-4.)
  appointmentId String?

  channel   NotificationChannel
  template  String
  recipient String?
  payload   Json
  status    OutboxStatus @default(pending)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?    @db.Timestamptz(3)

  /// A-048. WHICH adapter handled this row — `log` for the console adapter,
  /// the driver's own id once a real one lands. Per ROW, deliberately: the
  /// build-wide derivation it replaces meant that the day a real driver
  /// shipped, every message ever queued retroactively read "sent" on the
  /// appointment panel. NULL for rows written before this column existed,
  /// which is the same answer as `log` and correctly reads as "queued".
  deliveredBy String?
  /// A-048. The provider's own message id (Resend id, Twilio SID), when it
  /// returns one. `dispatch.ts` already received this and threw it away for
  /// want of somewhere to put it; a real driver needs it to reconcile, and a
  /// value you already hold is not a speculative column (D-13).
  externalId  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: the record that a client WAS told must outlive any
  /// attempt to delete the appointment, for the same reason AppointmentEvent
  /// is append-only.
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([appointmentId])
  /// A-048's claim orders the whole queue by age, across businesses — the
  /// dispatcher is not per-tenant. `[businessId, status]` cannot serve it.
  @@index([status, createdAt])
}

// ─────────────────────────── waitlist ───────────────────────────

model WaitlistEntry {
  id         String @id @default(cuid())
  businessId String
  clientId   String
  serviceId  String
  /// Empty = any qualified provider.
  providerIds String[]
  /// CalendarDay bounds — CHAR(10), never @db.Date.
  fromDay    String @db.Char(10)
  toDay      String @db.Char(10)
  /// e.g. ["morning","saturday"].
  dayParts   String[]

  status    WaitlistStatus @default(active)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([clientId])
}

/// A-018 / D-22. HOW FAR BEHIND a provider is running, right now, on one
/// business day.
///
/// A STORED DELTA, never a rewrite of `startAt`. The Milestone 1 operator
/// review's headline finding (R-1): the schema could record that an
/// appointment RAN late but not that the day IS late — so at 11:05 with Dana
/// forty minutes behind, the website is still selling her 11:15 while that
/// client sits in the waiting area, and the desk falls back to a sticky note.
/// A shadow calendar is what kills this product by week two.
///
/// Rewriting `startAt` instead would change the time on the confirmation the
/// client is already holding. "Push the column" (APPT-04) is the separate,
/// audited action that deliberately does rewrite it.
///
/// Deriving the delta from `startedAt` alone was rejected: check-in discipline
/// collapses exactly when the desk is three deep, which is when the delta
/// matters most.
model ProviderRunningLate {
  id         String @id @default(cuid())
  businessId String
  providerId String
  /// The BUSINESS calendar day — CHAR(10), never @db.Date (D-3).
  day        String @db.Char(10)

  /// How far behind, in minutes. Always positive: running EARLY is not a
  /// thing a salon needs to model — nobody is kept waiting by it.
  minutes Int

  /// D-9. Who said so, and when — "Dana is 40 behind" is a claim somebody
  /// made, and at 6pm the question is who.
  setByActor Actor
  actorRef   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// One per provider per day. Clearing it DELETES the row: absent means "on
  /// time", which is the state that needs no explanation.
  @@unique([providerId, day])
  @@index([businessId, day])
}

// ─────────────────────────── infrastructure ───────────────────────────

/// A-013. One counter per rate-limit key, for TOKEN-02's "the route is
/// rate-limited (it returns PII)".
///
/// NO `businessId`, and that is deliberate rather than an oversight of the
/// rule: the key is usually a client IP, which belongs to no tenant, and a
/// column that would have to be filled with a lie is worse than an absent one.
/// This is infrastructure, not a §8 entity — nothing in the domain reads it.
///
/// A DATABASE TABLE rather than an in-process Map because the deploy target is
/// serverless (Vercel): every instance would hold its own Map, so the real
/// limit would be N x the configured one, silently, with the multiplier set by
/// autoscaling. A counter that lies about the number it enforces is worse than
/// none, because it is trusted.
model RateLimitCounter {
  /// e.g. "manage:203.0.113.7". Namespaced by the caller so two limiters can
  /// never share a bucket.
  key String @id

  /// When the current window opened — the FIRST request in it, not a clock
  /// boundary. A fixed boundary lets a caller spend a full window's budget at
  /// 11:59:59 and another at 12:00:00.
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
